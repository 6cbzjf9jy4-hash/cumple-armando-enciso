  <script>
    const CONFIG = {
      homenajeado: "Armando Enciso",
      edad: 80,
      whatsapp: "595982112114",
      targetTimestamp: new Date(2026, 10, 14, 20, 0, 0).getTime(), // Noviembre es mes 10 (0-index)
      lugar: "Granja Madel, Caacupé Almada Km 62.100, Paraguay",
      mapsUrl: "https://maps.app.goo.gl/g6ahQU2gLPGsBAwp6?g_st=ipc"
    };

    // Respaldo visual si la imagen falla o tarda en cargar
    function cargarImagenRespaldo(img, etiqueta) {
      img.onerror = null;
      const svg = `
        <svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
          <rect width="400" height="400" fill="#2c563d"/>
          <circle cx="200" cy="180" r="48" fill="#c49a45"/>
          <text x="200" y="270" font-family="sans-serif" font-size="20" font-weight="bold" fill="#ffffff" text-anchor="middle">${etiqueta}</text>
        </svg>`;
      img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
    }

    // Cuenta Regresiva
    function actualizarCuentaRegresiva() {
      const ahora = new Date().getTime();
      const distancia = CONFIG.targetTimestamp - ahora;

      const elDias = document.getElementById("dias");
      const elHoras = document.getElementById("horas");
      const elMin = document.getElementById("minutos");
      const elSeg = document.getElementById("segundos");

      if (distancia <= 0) {
        document.getElementById("countdown").innerHTML = "<p style='grid-column: 1 / -1; text-align: center; font-weight: bold; font-size: 1.2rem; color: #1e3a29;'>🎉 ¡Hoy celebramos los 80 años de Don Armando! 🎉</p>";
        return;
      }

      const d = Math.floor(distancia / (1000 * 60 * 60 * 24));
      const h = Math.floor((distancia % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const m = Math.floor((distancia % (1000 * 60 * 60)) / (1000 * 60));
      const s = Math.floor((distancia % (1000 * 60)) / 1000);

      elDias.textContent = String(d).padStart(2, '0');
      elHoras.textContent = String(h).padStart(2, '0');
      elMin.textContent = String(m).padStart(2, '0');
      elSeg.textContent = String(s).padStart(2, '0');
    }
    setInterval(actualizarCuentaRegresiva, 1000);
    actualizarCuentaRegresiva();

    // Generar archivo .ics con hora local flotante (20:00 exactas en iOS y Android)
    document.getElementById("btn-descargar-ics").addEventListener("click", () => {
      const icsData = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//Armando Enciso 80 Anos//ES",
        "CALSCALE:GREGORIAN",
        "BEGIN:VEVENT",
        "SUMMARY:80 Años de Armando Enciso",
        "DESCRIPTION:Festejo de los 80 años de Don Armando en Granja Madel. Tenida Casual.\\nUbicación: " + CONFIG.mapsUrl,
        "LOCATION:" + CONFIG.lugar,
        "DTSTART:20261114T200000",
        "DTEND:20261115T030000",
        "STATUS:CONFIRMED",
        "END:VEVENT",
        "END:VCALENDAR"
      ].join("\r\n");

      const blob = new Blob([icsData], { type: "text/calendar;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.setAttribute("download", "cumpleanos-armando-enciso-80.ics");
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    });

    // Compartir Invitación (Web Share API nativa + portapapeles)
    document.getElementById("btn-compartir").addEventListener("click", async () => {
      const statusDiv = document.getElementById("status-compartir");
      statusDiv.textContent = "";

      const shareData = {
        title: "80 Años de Armando Enciso",
        text: "¡Te invito a celebrar los 80 años de Don Armando Enciso! Sábado 14 de noviembre de 2026 en Granja Madel.",
        url: window.location.href.split('#')[0]
      };

      if (navigator.share) {
        try {
          await navigator.share(shareData);
          statusDiv.className = "status-msg success";
          statusDiv.textContent = "¡Invitación compartida con éxito!";
        } catch (err) {
          if (err.name !== "AbortError") {
            copiarAlPortapapeles(shareData.url, statusDiv);
          }
        }
      } else {
        copiarAlPortapapeles(shareData.url, statusDiv);
      }
    });

    function copiarAlPortapapeles(url, statusDiv) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(() => {
          statusDiv.className = "status-msg success";
          statusDiv.textContent = "Enlace copiado al portapapeles. ¡Pégalo en tu chat!";
        }).catch(() => {
          statusDiv.className = "status-msg error";
          statusDiv.textContent = "No se pudo copiar automáticamente. Puedes copiar la dirección del navegador.";
        });
      } else {
        statusDiv.className = "status-msg success";
        statusDiv.textContent = "Copia la dirección del navegador para compartirla.";
      }
    }

    // Validación y Envío de Confirmación a WhatsApp
    document.getElementById("form-rsvp").addEventListener("submit", (e) => {
      e.preventDefault();
      const statusDiv = document.getElementById("status-rsvp");
      statusDiv.textContent = "";

      const nombre = document.getElementById("nombre").value.trim();
      const asistentes = parseInt(document.getElementById("asistentes").value, 10);
      const mensaje = document.getElementById("mensaje").value.trim();

      if (!nombre) {
        statusDiv.className = "status-msg error";
        statusDiv.textContent = "Por favor ingresa tu nombre y apellido.";
        document.getElementById("nombre").focus();
        return;
      }

      if (isNaN(asistentes) || asistentes < 1) {
        statusDiv.className = "status-msg error";
        statusDiv.textContent = "La cantidad de personas debe ser al menos 1.";
        document.getElementById("asistentes").focus();
        return;
      }

      let textoWsp = `¡Hola! Confirmo mi asistencia a los 80 años de ${CONFIG.homenajeado}.\n\n`;
      textoWsp += `👤 Nombre: ${nombre}\n`;
      textoWsp += `👥 Personas: ${asistentes}\n`;
      if (mensaje) {
        textoWsp += `💬 Mensaje: "${mensaje}"\n`;
      }
      textoWsp += `\nNos vemos el sábado 14 de noviembre en Granja Madel.`;

      const wspUrl = `https://api.whatsapp.com/send?phone=${CONFIG.whatsapp}&text=${encodeURIComponent(textoWsp)}`;
      window.open(wspUrl, "_blank", "noopener,noreferrer");

      statusDiv.className = "status-msg success";
      statusDiv.textContent = "Abriendo WhatsApp para enviar tu confirmación...";
    });
  </script>
